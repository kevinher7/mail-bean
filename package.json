{
  "name": "mail-bean",
  "version": "0.1.0",
  "description": "E-mail extractor for Actual Budget",
  "license": "MIT",
  "author": "Kevin Hernandez",
  "bin": {
    "mail-bean": "./bin/mail-bean.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env src/index.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "@actual-app/api": "^26.9.0",
    "@googleapis/gmail": "^18.0.0",
    "mailparser": "^3.9.20",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3"
  }
}
