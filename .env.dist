# Gmail Config
MAIL_BEAN_GOOGLE_CLIENT_ID=000000000000-example0fake0client0id0000000000.apps.googleusercontent.com
MAIL_BEAN_GOOGLE_CLIENT_SECRET=GOCSPX-EXAMPLE0FAKE0SECRET00000000

MAIL_BEAN_GOOGLE_REFRESH_TOKEN=1//0eEXAMPLE-FAKE-REFRESH-TOKEN-DO-NOT-USE

# Actual Config
MAIL_BEAN_ACTUAL_SERVER_URL=https://actual.example.com
MAIL_BEAN_ACTUAL_PASSWORD=example-fake-password

MAIL_BEAN_ACTUAL_SYNC_ID=00000000-0000-4000-8000-000000000000

## Only if end-to-end encryption is enabled on the budget. Leave empty if not.
MAIL_BEAN_ACTUAL_E2E_PASSWORD=example-fake-e2e-password

## Local cache directory for @actual-app/api. Gitignored.
MAIL_BEAN_ACTUAL_DATA_DIR=./.actual

## Maps each parser source account to the name of an account in Actual.
MAIL_BEAN_ACCOUNT_MAP={"smbc":"SMBC Debit","yucho":"Yucho"}

## Maps the name of a category in Actual to the payees that should default to it.
MAIL_BEAN_ACTUAL_CATEGORY_MAP='{
  "Conbini": ["Lawson", "Seven-Eleven", "Familymart"],
  "Subs": ["Openai *Chatgpt Subscr"],
  "Transport": ["Tap to Ride Japan W"],
  "Restaurant": ["Saizeriya", "Mcdonald S"]
}'

